{
	"name": "react-odontogram",
	"description": "dental chart for selecting teeth",
	"version": "0.5.6",
	"author": "Pratik Sharma <sharma.pratik2016@gmail.com>",
	"license": "MIT",
	"keywords": [
		"odontogram",
		"typodont",
		"react",
		"dental-chart",
		"dental",
		"tooth",
		"teeth",
		"dental-selector",
		"teeth-selector",
		"dentistry",
		"medical",
		"react-teeth-selector",
		"dental-notation"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/biomathcode/react-odontogram"
	},
	"scripts": {
		"dev": "concurrently \"pnpm build --watch\" \"pnpm storybook\" \"pnpm test\" ",
		"build": "tsup",
		"lint": "biome check --write --unsafe .",
		"lint:ci": "biome check --unsafe .",
		"test": "vitest",
		"test:ci": "vitest run --coverage",
		"commit": "cz",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"example:responsive": "cd examples/responsive-site && vite --host 127.0.0.1 --port 5174",
		"example:responsive:build": "cd examples/responsive-site && vite build",
		"release": "pnpm build && pnpm release-it",
		"link:self": "pnpm link --global",
		"prepare": "lefthook install",
		"deploy-storybook": "gh-pages -d storybook-static",
		"test:coverage": "vitest run --coverage"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./style.css": "./dist/index.css"
	},
	"sideEffects": ["*.css", "**/*.css"],
	"files": ["dist"],
	"config": {
		"commitizen": {
			"path": "./node_modules/@ryansonshine/cz-conventional-changelog"
		}
	},
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version}"
		},
		"github": {
			"release": true
		},
		"npm": {
			"publish": false
		}
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@ryansonshine/commitizen": "4.2.8",
		"@ryansonshine/cz-conventional-changelog": "3.3.4",
		"@storybook/addon-a11y": "^10.2.10",
		"@storybook/addon-docs": "10.4.0",
		"@storybook/addon-links": "10.4.0",
		"@storybook/addon-themes": "^10.2.10",
		"@storybook/addon-webpack5-compiler-swc": "4.0.3",
		"@storybook/react-webpack5": "10.4.0",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "22.13.11",
		"@types/react": "18.3.13",
		"@types/react-dom": "18.3.1",
		"@types/react-test-renderer": "18.3.0",
		"@vitest/coverage-v8": "3.0.9",
		"concurrently": "9.2.1",
		"dotenv": "^16.4.7",
		"gh-pages": "^6.3.0",
		"jsdom": "26.0.0",
		"lefthook": "1.11.3",
		"prop-types": "15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-test-renderer": "18.3.1",
		"release-it": "18.1.2",
		"storybook": "10.4.0",
		"ts-node": "10.9.2",
		"tsconfig-paths": "4.2.0",
		"tsup": "8.5.1",
		"tsx": "4.22.3",
		"typescript": "5.8.2",
		"vitest": "3.0.9"
	},
	"peerDependencies": {
		"react": ">=17",
		"react-dom": ">=17"
	}
}
